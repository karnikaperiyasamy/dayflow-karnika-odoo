# PostgreSQL connection. On Replit, use the DATABASE_URL provided by the Replit Postgres integration.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dayflow

# JWT secret - generate a long random string for production
JWT_SECRET=change-this-to-a-long-random-secret

# Port the backend server listens on
PORT=5000

# Set to "true" to auto-print email verification links to the server console
# (used since no real email service is configured in this hackathon prototype)
DEV_EMAIL_MODE=true
